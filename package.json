{
  "name": "internet-redactor",
  "private": true,
  "version": "0.1.0",
  "description": "Privacy-first Electron app to redact user content via official APIs",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "pnpm --filter @internet-redactor/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r --filter ./packages/** test",
    "test:e2e": "pnpm --filter @internet-redactor/desktop test:e2e",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "@eslint/js": "^9.14.0",
    "typescript-eslint": "^8.14.0"
  }
}
